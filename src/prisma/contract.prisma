model User {
  id           String   @id @default(cuid(2))
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    temporal.updatedAt()

  events       Event[]
}

model Event {
  id          String   @id @default(cuid(2))
  title       String
  description String
  location    String
  date        DateTime
  createdAt   DateTime @default(now())

  organizerId String
  organizer   User     @relation(
    fields: [organizerId],
    references: [id]
  )
}